# Non-interactive Apptainer build job: builds focapo.sif and copies it to /staging/p/prbrahmbhatt.
#   condor_submit build.sub
+IsBuildJob = True
requirements = (HasCHTCStaging == true)
executable            = build.sh
transfer_input_files  = focapo.def
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
request_cpus   = 4
request_memory = 8GB
request_disk   = 12GB
log    = build_$(Cluster).log
output = build_$(Cluster).out
error  = build_$(Cluster).err
queue 1
